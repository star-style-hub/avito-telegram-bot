# Скопируйте в .env и заполните. Файл .env не попадает в git.

# Avito API: https://www.avito.ru/professionals/api (Client ID / Client secret приложения)
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Необязательно: ID вашего аккаунта Авито (если пусто — определяется через /core/v1/accounts/self)
AVITO_USER_ID=

# Telegram: токен от @BotFather и ID чата, куда слать уведомления
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно
POLL_INTERVAL_SECONDS=30
STATE_FILE=state.json
# true — при первом запуске уведомить и о уже существующих непрочитанных
NOTIFY_EXISTING_UNREAD=false
